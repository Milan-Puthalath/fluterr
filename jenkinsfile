pipeline {
    agent any

    environment {
        FLUTTER_HOME = 'C:\\src\\flutter'
        PATH = "C:\\src\\flutter\\bin;${env.PATH}"
    }

    stages {

        stage('Check Flutter') {
            steps {
                bat '''
                    echo Checking Flutter...
                    where flutter
                    flutter --version
                    dart --version
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'flutter pub get'
            }
        }

        stage('Analyze') {
            steps {
                bat 'flutter analyze'
            }
        }

        stage('Test') {
            steps {
                bat 'flutter test'
            }
        }

        stage('Build Web') {
            steps {
                bat 'flutter build web'
            }
        }

        stage('Archive Web') {
            steps {
                archiveArtifacts artifacts: 'build/web/**', allowEmptyArchive: false
            }
        }
    }
}
